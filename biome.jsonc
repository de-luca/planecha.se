{
	"$schema": "https://biomejs.dev/schemas/2.0.5/schema.json",
	"files": {
	    "includes": ["**", "!src/components/ui/**"]
  	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noNonNullAssertion": "off"
			},
			"recommended": true
		}
	}
}
